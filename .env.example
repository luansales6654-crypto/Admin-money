# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EMAIL / SMTP CONFIGURATION (Optional - for sending real verification emails to customers)
# Example for Gmail:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="seu-email@gmail.com"
# SMTP_PASS="sua-senha-de-app-google"
# EMAIL_FROM='"Admin Money" <seu-email@gmail.com>'

# Example for Brevo / SendGrid / Mailgun:
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USER="seu-login"
# SMTP_PASS="sua-chave-smtp"
